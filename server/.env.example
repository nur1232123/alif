# Скопируйте этот файл в server/.env и впишите свои ключи.
# Файл .env не попадает на GitHub, ключи остаются только у вас.

# Azure Speech: озвучка курса и проверка голоса (бесплатный тариф F0)
AZURE_KEY=
AZURE_REGION=westeurope

# Google Gemini: ИИ-учитель (бесплатный ключ из aistudio.google.com)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# Любая длинная строка. Такая же должна быть в EXPO_PUBLIC_SERVER_TOKEN в файле .env приложения
APP_TOKEN=
