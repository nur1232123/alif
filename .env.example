# Скопируйте этот файл в .env (в корне проекта).
# Адрес сервера «Алиф»: его показывает команда npm.cmd run server
EXPO_PUBLIC_SERVER_URL=
# Должен совпадать с APP_TOKEN в server/.env
EXPO_PUBLIC_SERVER_TOKEN=
# Режим проверки для автора: все уроки открыты. Для учеников не указывайте
EXPO_PUBLIC_TEST_MODE=1
# Публичные ключи RevenueCat для подписки (app.revenuecat.com → Project settings → API keys)
EXPO_PUBLIC_RC_ANDROID_KEY=
EXPO_PUBLIC_RC_IOS_KEY=
# Общедоступная ссылка на политику конфиденциальности (нужна магазинам)
EXPO_PUBLIC_PRIVACY_URL=
# Ключ проверяющего: такой же, как TESTER_KEY на сервере. С ним учитель без лимита. Только у автора
EXPO_PUBLIC_TESTER_KEY=
# Supabase для входа по почте (supabase.com → Project Settings → API Keys): адрес проекта и публичный ключ
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Оплата: web — через сайт (RevenueCat + Paddle), store — Google Play и App Store
EXPO_PUBLIC_BILLING=web
# Ссылка на оплату RevenueCat (Funnels → Purchase Links)
EXPO_PUBLIC_WEB_PURCHASE_URL=
