# Скопируйте этот файл в .env (в корне проекта).
# Адрес сервера «Алиф»: его показывает команда npm.cmd run server
EXPO_PUBLIC_SERVER_URL=
# Должен совпадать с APP_TOKEN в server/.env
EXPO_PUBLIC_SERVER_TOKEN=
# Режим проверки для автора: все уроки открыты. Для учеников не указывайте
EXPO_PUBLIC_TEST_MODE=1
