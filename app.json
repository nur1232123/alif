{
  "expo": {
    "name": "Алиф",
    "slug": "alif-arabic",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.alifarabic.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B6E5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.alifarabic.mobile",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Микрофон нужен, чтобы проверить произношение на экзамене.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Местоположение нужно, чтобы рассчитать время намаза и направление киблы. Оно не покидает телефон."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B6E5F",
          "sounds": [
            "./assets/sounds/adhan_full.mp3",
            "./assets/sounds/adhan_short.mp3"
          ]
        }
      ]
    ],
    "scheme": "alif",
    "experiments": {
      "typedRoutes": false
    },
    "description": "Курс арабского языка на год: от букв до разговора.",
    "owner": "alif.arabic.app",
    "extra": {
      "eas": {
        "projectId": "29f8eb4d-d5a3-425e-bc02-e30179f161d8"
      }
    },
    "runtimeVersion": "1.3.0",
    "updates": {
      "url": "https://u.expo.dev/29f8eb4d-d5a3-425e-bc02-e30179f161d8"
    }
  }
}
